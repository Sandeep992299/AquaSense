# ── AquaSense – Environment Variables ──────────────────────
# Copy this to .env and fill in your values.
# For local dev, the defaults below work with docker-compose.
# For AWS deployment, set these in ECS Task Definitions or Secrets Manager.

# ── Database (PostgreSQL / Aurora) ──────────────────────────
DB_HOST=postgres          # docker-compose service name (local)
                          # On AWS: Aurora cluster endpoint
DB_PORT=5432
DB_NAME=aquasense_db
DB_USER=aqua_admin
DB_PASSWORD=changeme      # CHANGE THIS – use AWS Secrets Manager on AWS
DB_SSL=false              # Set to 'true' on Aurora (SSL required)
DB_POOL_MAX=10

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=local-dev-jwt-secret-change-in-production

# ── Service URLs (docker-compose service names) ───────────────
USAGE_SERVICE_URL=http://usage-service:8083     # billing + alert call this
BILLING_SERVICE_URL=http://billing-service:8082

# ── AWS (not used locally – for future deployment) ───────────
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT_ID:asu-alerts
# SQS_ALERT_QUEUE=alert-processing-queue
# AWS_REGION=ap-south-1

# ── Ports ────────────────────────────────────────────────────
# user-service    runs on 8081
# billing-service runs on 8082
# usage-service   runs on 8083
# alert-service   runs on 8084
