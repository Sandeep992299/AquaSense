# ──────────────────────────────────────────────────────────────────────────
# AquaSense IoT Simulator – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env (it is git-ignored).
# ──────────────────────────────────────────────────────────────────────────

# AWS IoT Core ATS endpoint
# Find it: AWS Console → IoT Core → Settings → Device data endpoint
ENDPOINT=xxxxxx-ats.iot.us-east-1.amazonaws.com

# Paths to X.509 credentials (relative to the simulator directory)
CERT_PATH=certs/meter-001/device.pem.crt
KEY_PATH=certs/meter-001/private.pem.key
CA_PATH=certs/AmazonRootCA1.pem

# Comma-separated list of meter IDs to simulate
METER_IDS=meter-001,meter-002,meter-003

# Seconds between successive readings per meter
PUBLISH_INTERVAL=5

# Set to "1" to connect via a local Greengrass Core instead of IoT Core directly
GREENGRASS_MODE=0
